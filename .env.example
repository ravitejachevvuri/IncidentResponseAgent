# Database
POSTGRES_USER=production_memory
POSTGRES_PASSWORD=production_memory
POSTGRES_DB=production_memory
DATABASE_URL=postgresql+psycopg2://production_memory:production_memory@db:5432/production_memory

# Hindsight (https://hindsight.vectorize.io) - the required memory layer.
# Sign up at https://ui.hindsight.vectorize.io/signup (apply promo code
# MEMHACK99 for $50 credit in the billing section), then fill these in from
# your dashboard. Leave both empty to fall back to Groq/deterministic
# recommendations and the Postgres-based structured similarity search.
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=

# LLM (Groq - OpenAI-compatible API). Leave GROQ_API_KEY empty to force the
# deterministic fallback recommendation path (see app/ai/llm_client.py).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Frontend
VITE_API_BASE_URL=http://localhost:8000
